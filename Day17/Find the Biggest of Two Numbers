import java.util.*;
public class FindtheBiggestofTwoNumbers {
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int m=sc.nextInt();
        if(n>m){
            System.out.println(n+"is the biggest number");
        }
        else{
            System.out.println(m+"is the biggest number");
        }
    }
}
